# ==============================================================================
# Scratchly Mail - Environment Configuration Template
# All secret values must be supplied locally via a .env file.
# NEVER commit real credentials to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Default local docker-compose uses port 5433 to avoid host port collisions
DATABASE_URL="postgresql://user:password@localhost:5432/scratchly_mail?schema=public"

# ------------------------------------------------------------------------------
# Security & Token Encryption
# ------------------------------------------------------------------------------
# JWT / Session secret (minimum 32 characters)
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"

# AES-256-GCM encryption key for OAuth tokens stored at rest (exactly 32 bytes hex encoded = 64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# Bulk Email Delivery Engine (Amazon SES & Provider Settings)
# ------------------------------------------------------------------------------
# Default sending mode: 'dry-run' or 'ses'
# IMPORTANT: Defaults to 'dry-run' to prevent accidental external email delivery
CAMPAIGN_SENDING_MODE=dry-run

# Amazon SES Configuration (Required only when CAMPAIGN_SENDING_MODE=ses)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SES_FROM_EMAIL=verified-sender@example.com
AWS_SES_CONFIGURATION_SET=scratchly-mail-events

# SES Event Webhook Secret (used for verifying SNS / EventBridge delivery callbacks)
SES_WEBHOOK_SECRET=your-ses-webhook-signing-secret

# ------------------------------------------------------------------------------
# Google OAuth 2.0 & Gmail Integration
# ------------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Supported redirect URIs: http://localhost:4000/api/integrations/gmail/callback or http://localhost:4000/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/gmail/callback

# Allowed scopes: openid email profile https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose
GOOGLE_OAUTH_SCOPES="openid,email,profile,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.compose"

# ------------------------------------------------------------------------------
# Scratchly CRM Integration Boundary (Future placeholder)
# ------------------------------------------------------------------------------
SCRATCHLY_CRM_ENABLED=false
SCRATCHLY_CRM_BASE_URL=https://api.scratchlycrm.app/v1
SCRATCHLY_CRM_API_KEY=
SCRATCHLY_CRM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Background Queue & Worker Settings
# ------------------------------------------------------------------------------
# DB Queue polling interval in milliseconds
QUEUE_POLL_INTERVAL_MS=2000
# Maximum recipients processed concurrently in a single batch
QUEUE_BATCH_SIZE=50
# Worker lock timeout in seconds before stale jobs can be reclaimed
QUEUE_LOCK_TIMEOUT_SEC=120
